{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "huyenbao-edge",
  "main": "worker.js",
  "compatibility_date": "2026-10-12",
  "workers_dev": false,
  "routes": [
    { "pattern": "huyenbao.com/*", "zone_name": "huyenbao.com" },
    { "pattern": "www.huyenbao.com/*", "zone_name": "huyenbao.com" }
  ],
  "vars": {
    "BACKEND_ORIGIN": "https://api.huyenbao.com",
    "CORS_ALLOWED_ORIGINS": "https://huyenbao.com,https://www.huyenbao.com"
  },
  "ratelimits": [
    {
      "name": "API_LIMITER",
      "namespace_id": "731001",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      "name": "AUTH_LIMITER",
      "namespace_id": "731002",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "COMPUTE_LIMITER",
      "namespace_id": "731003",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  }
}
